# ProMiners — Frontend Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# ─── Public application configuration ──────────────────────────────────────────
# These values are intentionally exposed to the browser.

# The public-facing URL of this application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application name (used in metadata and UI)
NEXT_PUBLIC_APP_NAME=ProMiners

# Demo/development mode flag — set to "true" to show demo data banners
NEXT_PUBLIC_DEMO_MODE=true

# ─── Blockchain / Web3 (APPROVED D-04: Ethereum Sepolia Testnet) ─────────────────
# Milestone 1-B exclusively targets Ethereum Sepolia Testnet (Chain ID: 11155111)

# Default chain ID (11155111 for Ethereum Sepolia Testnet)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111

# WalletConnect Cloud Project ID (obtain free at https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=3fcc6bba2d1de9622da67d1c4064d37d

# Sepolia RPC URL (leave blank to use Viem's default public RPCs, or add Alchemy/Infura)
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Block explorer base URL
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io

# ─── Server-side only (NOT prefixed with NEXT_PUBLIC_) ─────────────────────────
# These are NEVER exposed to the browser.

# Backend API base URL (added when backend is implemented)
# API_BASE_URL=http://localhost:4000

# MongoDB connection string (added when database is configured)
# DATABASE_URL=mongodb://localhost:27017/prominers

# Session / auth secret (added when auth is implemented)
# AUTH_SECRET=

# KYC provider API key (PENDING D-09)
# KYC_API_KEY=

# Market data provider API key (PENDING D-08)
# MARKET_DATA_API_KEY=
