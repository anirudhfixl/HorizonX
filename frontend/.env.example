# ProMiners — Frontend Environment Variables
# Copy this file to .env.local (Vite loads .env, .env.local, .env.[mode]) and fill in real values.
# Never commit .env.local to version control.

# ─── Public application configuration ──────────────────────────────────────────
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# The public-facing URL of this application (no trailing slash)
VITE_APP_URL=http://localhost:3000

# Application name (used in metadata and UI)
VITE_APP_NAME=ProMiners

# Demo/development mode flag — set to "true" to show demo data banners
VITE_DEMO_MODE=true

# ─── Blockchain / Web3 (APPROVED D-04: Ethereum Sepolia Testnet) ─────────────────
# Milestone 1-B exclusively targets Ethereum Sepolia Testnet (Chain ID: 11155111)

# Default chain ID (11155111 for Ethereum Sepolia Testnet)
VITE_DEFAULT_CHAIN_ID=11155111

# WalletConnect Cloud Project ID (obtain free at https://cloud.reown.com)
VITE_WALLETCONNECT_PROJECT_ID=3fcc6bba2d1de9622da67d1c4064d37d

# Sepolia RPC URL (leave blank to use Viem's default public RPCs, or add Alchemy/Infura)
# VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Block explorer base URL
VITE_EXPLORER_URL=https://sepolia.etherscan.io

# ─── Backend / Serverless environment variables ──────────────────────────────
# A Vite app is a static browser bundle: secrets must live in serverless functions, never in VITE_ variables.
# CoinMarketCap API key for serverless market data proxy (/api/market).
# Never prefix with VITE_ to prevent leaking into client bundles.
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# CryptoRank API key for serverless airdrop and launchpad data proxy (/api/cryptorank or /api/market).
# Required for live CryptoRank v3 drophunting and public sales data.
# When missing, application gracefully provides local HorizonX ecosystem records.
# Never prefix with VITE_ to prevent leaking into client bundles.
CRYPTORANK_API_KEY=your_cryptorank_api_key_here


