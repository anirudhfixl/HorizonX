# ProMiners — root .gitignore

# ─── Environment files ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.local

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Next.js ──────────────────────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
*.tsbuildinfo

# ─── Testing ──────────────────────────────────────────────────────────────────
coverage/

# ─── Hardhat / Contracts (future) ─────────────────────────────────────────────
contracts/artifacts/
contracts/cache/
contracts/typechain-types/

# ─── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.swp
*.swo

# ─── Secrets / Keys ───────────────────────────────────────────────────────────
*.key
*.p12
*.pfx
secrets/
